# Copy this file to .env and fill in local values. Never commit the real .env.
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local PostgreSQL 16 connection
POSTGRES_DB=tabilo_dev
POSTGRES_USER=tabilo_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
